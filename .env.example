# Leave DATABASE_URL unset for local mode: PGlite in .pglite/, demo data,
# sign-in emails printed to the console and written to .outbox.jsonl.

# Postgres connection string (e.g. Neon via the Vercel marketplace)
DATABASE_URL=

# Public URL of this instance, without trailing slash
BETTER_AUTH_URL=https://gigg.example.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Comma-separated. Admins can sign up themselves and (later) create bands.
ADMIN_EMAILS=you@example.com

# Any SMTP provider, e.g. Resend: smtps://resend:<api-key>@smtp.resend.com:465
SMTP_URL=
MAIL_FROM="Gigg <no-reply@example.com>"
