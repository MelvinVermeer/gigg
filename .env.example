# Leave DATABASE_URL unset for local mode: PGlite in .pglite/, demo data,
# sign-in emails printed to the console and written to .outbox.jsonl.
# A production build (pnpm build && pnpm start) also needs LOCAL_MODE=1 for that.

# Postgres connection string (e.g. Neon via the Vercel marketplace)
DATABASE_URL=

# Public URL of this instance, without trailing slash
BETTER_AUTH_URL=https://gigg.example.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Comma-separated. Admins can sign up themselves and (later) create bands.
ADMIN_EMAILS=you@example.com

# Self-service sign-up: anyone can start a band with their email and a band name. Off when unset.
OPEN_SIGNUP=

# Most storage (files) a band may use, in MB, e.g. 1024. No limit when unset.
BAND_STORAGE_LIMIT_MB=

# Email: either a Resend API key (sending access) ...
RESEND_API_KEY=
# ... or any SMTP provider (takes precedence), e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Gigg <no-reply@example.com>"

# Push notifications. Generate with: npx web-push generate-vapid-keys. Unset: no push (logged instead).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# File uploads: a Vercel Blob store (private). Unset in local mode: files go to .uploads/
BLOB_READ_WRITE_TOKEN=

# Feedback as GitHub issues too (only the text: no name, email or band). Repo as owner/name; a token with Issues: write.
GITHUB_REPO=
GITHUB_TOKEN=
